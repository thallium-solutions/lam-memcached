# @lam/memcached — Result-first binary-protocol Memcached client.

from lamerrors import Error, Result

# Direct Go is intentionally limited to the mc/v3 client boundary.
go! {
    import (
        "errors"
        "fmt"

        mcgo "github.com/memcachier/mc/v3"
    )

    func lamMcIsNotFound(err error) bool {
        return err != nil && errors.Is(err, mcgo.ErrNotFound)
    }

    func lamMcIsKeyExists(err error) bool {
        return err != nil && errors.Is(err, mcgo.ErrKeyExists)
    }

    func lamMcIsNotStored(err error) bool {
        return err != nil && errors.Is(err, mcgo.ErrValueNotStored)
    }

    func lamMcFailure(operation string, err error) *LAMMERGEIER.Result {
        return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
            "MemcachedError", fmt.Sprintf("memcached: %s: %v", operation, err), nil,
        ))
    }

    func lamMcMissing(operation string, key string) *LAMMERGEIER.Result {
        return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
            "MemcachedNotFound", fmt.Sprintf("memcached: %s %s: key not found", operation, key), nil,
        ))
    }
}

class Memcached {
    #- Binary-protocol client backed by a goroutine-safe mc/v3 connection pool.
       Every operation that can fail at the service or transport boundary returns
       Result. A missing value is MemcachedNotFound rather than an empty string. -#

    func init(self) {
        self._client: any = None
    }

    static func connect(addr: str, username: str = "", password: str = "") -> Result[Memcached] {
        #- Construct a client and eagerly complete a NOOP round trip. -#
        if addr.trim() == "" {
            return Result.Err(Error("MemcachedArgumentError", "memcached: address must not be empty", None))
        }
        go! {
            client := mcgo.NewMC(addr, username, password)
            if err := client.NoOp(); err != nil {
                client.Quit()
                return lamMcFailure("connect", err)
            }
            value := NewMemcached()
            value._client = client
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    func close(self) -> Result[any] {
        #- Release every pooled connection. Calling close twice succeeds. -#
        go! {
            if client, ok := s._client.(*mcgo.Client); ok && client != nil {
                client.Quit()
            }
            s._client = nil
            return LAMMERGEIER.Result.Ok(nil)
        }
    }

    func get(self, key: str) -> Result[str] {
        #- Return the stored value; a missing key is MemcachedNotFound. -#
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("GET "+key, errors.New("client is closed"))
            }
            value, _, _, err := client.Get(key)
            if lamMcIsNotFound(err) {
                return lamMcMissing("GET", key)
            }
            if err != nil {
                return lamMcFailure("GET "+key, err)
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    func set(self, key: str, value: str, ttlSec: int = 0) -> Result[bool] {
        if ttlSec < 0 {
            return Result.Err(Error("MemcachedArgumentError", "memcached: ttlSec cannot be negative", None))
        }
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("SET "+key, errors.New("client is closed"))
            }
            if _, err := client.Set(key, value, 0, uint32(ttlSec), 0); err != nil {
                return lamMcFailure("SET "+key, err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func add(self, key: str, value: str, ttlSec: int = 0) -> Result[bool] {
        #- Ok(false) means the key already exists. -#
        if ttlSec < 0 {
            return Result.Err(Error("MemcachedArgumentError", "memcached: ttlSec cannot be negative", None))
        }
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("ADD "+key, errors.New("client is closed"))
            }
            _, err := client.Add(key, value, 0, uint32(ttlSec))
            if lamMcIsKeyExists(err) {
                return LAMMERGEIER.Result.Ok(false)
            }
            if err != nil {
                return lamMcFailure("ADD "+key, err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func replace(self, key: str, value: str, ttlSec: int = 0) -> Result[bool] {
        #- Ok(false) means the key does not exist. -#
        if ttlSec < 0 {
            return Result.Err(Error("MemcachedArgumentError", "memcached: ttlSec cannot be negative", None))
        }
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("REPLACE "+key, errors.New("client is closed"))
            }
            _, err := client.Replace(key, value, 0, uint32(ttlSec), 0)
            if lamMcIsNotFound(err) {
                return LAMMERGEIER.Result.Ok(false)
            }
            if err != nil {
                return lamMcFailure("REPLACE "+key, err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func delete(self, key: str) -> Result[bool] {
        #- Ok(false) means the key did not exist. -#
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("DELETE "+key, errors.New("client is closed"))
            }
            err := client.Del(key)
            if lamMcIsNotFound(err) {
                return LAMMERGEIER.Result.Ok(false)
            }
            if err != nil {
                return lamMcFailure("DELETE "+key, err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func exists(self, key: str) -> Result[bool] {
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("EXISTS "+key, errors.New("client is closed"))
            }
            _, _, _, err := client.Get(key)
            if lamMcIsNotFound(err) {
                return LAMMERGEIER.Result.Ok(false)
            }
            if err != nil {
                return lamMcFailure("EXISTS "+key, err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func touch(self, key: str, ttlSec: int) -> Result[bool] {
        #- Ok(false) means the key does not exist. -#
        if ttlSec < 0 {
            return Result.Err(Error("MemcachedArgumentError", "memcached: ttlSec cannot be negative", None))
        }
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("TOUCH "+key, errors.New("client is closed"))
            }
            _, err := client.Touch(key, uint32(ttlSec))
            if lamMcIsNotFound(err) {
                return LAMMERGEIER.Result.Ok(false)
            }
            if err != nil {
                return lamMcFailure("TOUCH "+key, err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func incr(self, key: str, by: int = 1, initial: int = 0, ttlSec: int = 0) -> Result[int] {
        if by < 0 or initial < 0 or ttlSec < 0 {
            return Result.Err(Error("MemcachedArgumentError", "memcached: counter values and ttlSec cannot be negative", None))
        }
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("INCR "+key, errors.New("client is closed"))
            }
            value, _, err := client.Incr(key, uint64(by), uint64(initial), uint32(ttlSec), 0)
            if err != nil {
                return lamMcFailure("INCR "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(value))
        }
    }

    func decr(self, key: str, by: int = 1, initial: int = 0, ttlSec: int = 0) -> Result[int] {
        if by < 0 or initial < 0 or ttlSec < 0 {
            return Result.Err(Error("MemcachedArgumentError", "memcached: counter values and ttlSec cannot be negative", None))
        }
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("DECR "+key, errors.New("client is closed"))
            }
            value, _, err := client.Decr(key, uint64(by), uint64(initial), uint32(ttlSec), 0)
            if err != nil {
                return lamMcFailure("DECR "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(value))
        }
    }

    func append(self, key: str, value: str) -> Result[bool] {
        #- Ok(false) means the key does not exist. -#
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("APPEND "+key, errors.New("client is closed"))
            }
            _, err := client.Append(key, value, 0)
            if lamMcIsNotFound(err) || lamMcIsNotStored(err) {
                return LAMMERGEIER.Result.Ok(false)
            }
            if err != nil {
                return lamMcFailure("APPEND "+key, err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func prepend(self, key: str, value: str) -> Result[bool] {
        #- Ok(false) means the key does not exist. -#
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("PREPEND "+key, errors.New("client is closed"))
            }
            _, err := client.Prepend(key, value, 0)
            if lamMcIsNotFound(err) || lamMcIsNotStored(err) {
                return LAMMERGEIER.Result.Ok(false)
            }
            if err != nil {
                return lamMcFailure("PREPEND "+key, err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func flush(self, when: int = 0) -> Result[bool] {
        if when < 0 {
            return Result.Err(Error("MemcachedArgumentError", "memcached: flush delay cannot be negative", None))
        }
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("FLUSH", errors.New("client is closed"))
            }
            if err := client.Flush(uint32(when)); err != nil {
                return lamMcFailure("FLUSH", err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func noop(self) -> Result[bool] {
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("NOOP", errors.New("client is closed"))
            }
            if err := client.NoOp(); err != nil {
                return lamMcFailure("NOOP", err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func version(self) -> Result[dict[str, str]] {
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("VERSION", errors.New("client is closed"))
            }
            values, err := client.Version()
            if err != nil {
                return lamMcFailure("VERSION", err)
            }
            out := make(map[string]string, len(values))
            for server, value := range values {
                out[server] = value
            }
            return LAMMERGEIER.Result.Ok(out)
        }
    }

    func stats(self) -> Result[dict[str, dict[str, str]]] {
        go! {
            client, ok := s._client.(*mcgo.Client)
            if !ok || client == nil {
                return lamMcFailure("STATS", errors.New("client is closed"))
            }
            values, err := client.Stats()
            if err != nil {
                return lamMcFailure("STATS", err)
            }
            out := make(map[string]map[string]string, len(values))
            for server, stats := range values {
                inner := make(map[string]string, len(stats))
                for name, value := range stats {
                    inner[name] = value
                }
                out[server] = inner
            }
            return LAMMERGEIER.Result.Ok(out)
        }
    }
}
