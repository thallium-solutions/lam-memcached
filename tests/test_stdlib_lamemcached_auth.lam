# Integration test: Result-first SASL credential path.
#
# expect: pong-after-auth: ok
# expect: set-and-get-auth: secret-value
# expect: incr-auth-nonzero: true
# expect: stats-nonempty: true

from @lam/memcached import Memcached
from lamerrors import Result

func run() -> Result[bool] {
    m: Memcached = Memcached.connect(
    "localhost:11212",
    username = "memuser",
    password = "mempass123",
    )?
    _ = m.flush()?

    _ = m.noop()?
    print("pong-after-auth: ok")

    _ = m.set("auth:key", "secret-value")?
    value: str = m.get("auth:key")?
    print("set-and-get-auth: " + value)

    _ = m.incr("auth:counter", 1, 0)?
    n: int = m.incr("auth:counter")?
    print("incr-auth-nonzero: " + str(n > 0))

    serverStats: dict[str, dict[str, str]] = m.stats()?
    print("stats-nonempty: " + str(len(serverStats) > 0))

    _ = m.flush()?
    _ = m.close()?
    return Result.Ok(true)
}

func main() {
    _ = run().unwrap()
}
